# Copia este archivo como .env (en la raíz para Docker, o en backend/ para correrlo sin Docker).

# Dominio público del portal (Caddy saca el certificado HTTPS para este nombre)
DOMINIO=mochila.olafibonacci.org

# Clave para firmar las sesiones: mínimo 32 caracteres, secreta y estable.
# Genera una con:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Si la dejas vacía se genera una sola vez y se guarda en datos/.secret_key
SECRET_KEY=

# Primer Superadmin (se crea al arrancar si todavía no existe ninguno)
SUPERADMIN_USUARIO=admin
SUPERADMIN_NOMBRE=Equipo Ola Fibonacci
SUPERADMIN_CONTRASENA=cambia-esta-contrasena

# Cuántas horas dura una sesión antes de pedir login otra vez (24 = un día)
TOKEN_HORAS=24

# Tamaño máximo de cada archivo subido, en MB
MAX_SUBIDA_MB=100

# Zona horaria del cronograma
ZONA_HORARIA=America/Bogota

# ---------------------------------------------------------------- correo
# Para que "¿Olvidaste tu contraseña?" envíe correos de verdad. Sin SMTP_HOST,
# cada correo se guarda como archivo en datos/correos/ (útil para probar).
#
# Con Gmail (500 correos al día, de sobra para el evento):
#   1. En la cuenta de Google que enviará los correos, activa la verificación en 2 pasos.
#   2. Crea una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
#   3. Pega esos 16 caracteres en SMTP_CONTRASENA (con o sin espacios).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_SEGURIDAD=starttls
SMTP_USUARIO=
SMTP_CONTRASENA=
CORREO_REMITENTE=Mochila virtual Space Apps <tucorreo@gmail.com>

# Dirección pública del portal para los enlaces de los correos. Normalmente vacía:
# en el servidor se usa https://DOMINIO/ y en tu computador, la dirección desde la que abres el portal.
PORTAL_URL=

# Solo si el frontend vive en otro dominio distinto al de la API (separados por coma)
CORS_ORIGINS=
